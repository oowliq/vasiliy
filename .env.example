# Токен бота (формат <application_id>.<secret>) — из настроек приложения на вашем инстансе.
FLUXER_BOT_TOKEN=

# Корневой адрес инстанса Fluxer (без /api и /v1), например https://fluxer.example.com
# Оставьте пустым для официального fluxer.app.
FLUXER_INSTANCE=

# Префикс команд.
BOT_PREFIX=!

STATS_DB_PATH=./data/stats.db
